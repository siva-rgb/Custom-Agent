{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsdk.invalid/schemas/plan.schema.json",
  "title": "A planner's plan (FR-65)",
  "description": "What a planner emits. The SDK builds a PlanVersion from it and checks the rest: exact strings, storability, per-kind criterion fields, and that the dependencies form a DAG.",
  "type": "object",
  "required": ["nodes"],
  "additionalProperties": false,
  "properties": {
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/node"}
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "node": {
      "type": "object",
      "required": ["node_id", "objective", "assigned_role"],
      "additionalProperties": false,
      "properties": {
        "node_id": {"$ref": "#/$defs/text"},
        "objective": {"$ref": "#/$defs/text"},
        "dependencies": {"type": "array", "items": {"$ref": "#/$defs/text"}, "uniqueItems": true},
        "assigned_role": {"$ref": "#/$defs/text"},
        "input_refs": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "expected_output_schema": {"type": ["object", "null"]},
        "acceptance_criteria": {"type": "array", "items": {"$ref": "#/$defs/criterion"}},
        "budget_reservation": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "usd": {"type": ["string", "null"], "pattern": "^[0-9]+(\\.[0-9]+)?$"},
            "tokens": {"type": ["integer", "null"], "minimum": 1}
          }
        },
        "side_effecting": {"type": "boolean"},
        "timeout": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "retry_policy": {
          "type": ["object", "null"],
          "required": ["max_attempts"],
          "additionalProperties": false,
          "properties": {"max_attempts": {"type": "integer", "minimum": 1}}
        },
        "risk_class": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "criterion": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["output_schema", "artifact_exists", "tool_succeeds", "critic"]},
        "target": {"type": ["string", "null"]},
        "arguments": {"type": ["object", "null"]},
        "description": {"type": ["string", "null"]}
      }
    }
  }
}
